{
  "manifest_version": 3,
  "name": "Website Blocker",
  "description": "Block distracting websites with a focused dashboard and inspirational quotes.",
  "version": "1.0",
  "permissions": ["declarativeNetRequest","declarativeNetRequestFeedback", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Website Blocker"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
